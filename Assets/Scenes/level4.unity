      propertyPath: dialogLines.Array.data[0].text
      value: "\u539F\u6765\uFF0C\u6211\u6389\u4E0B\u5730\u6D1E\u540E\u6655\u5012\u5728\u4E86\u8DEF\u8FB9\uFF0C\u662F\u7EBF\u6BB5\u6551\u4E86\u6211\u3002\u4E0D\u7136\uFF0C\u518D\u78B0\u4E0A\u90A3\u5012\u9709\u50AC\u7684\u516D\u8FB9\u5F62\u6211\u5C31\u60E8\u4E86\u3002"
