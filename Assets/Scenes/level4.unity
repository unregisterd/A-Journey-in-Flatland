      propertyPath: dialogLines.Array.data[3].text
      value: "\u7EBF\u6BB5\u5E76\u4E0D\u5C5E\u4E8E\u5E73\u9762\u56FD\u7684\u516C\u6C11\uFF0C\u51C6\u786E\u6765\u8BF4\uFF0C\u5979\u4EEC\u5E76\u4E0D\u5C5E\u4E8E\u201C\u4EBA\u201D\u7684\u8303\u7574\uFF0C\u800C\u662F\u67D0\u67D0\u7684\u6240\u6709\u7269\u3002\r\n\u6551\u52A9\u6211\u7684\u7EBF\u6BB5\u80CC\u7740\u5BB6\u91CC\u5077\u6E9C\u51FA\u6765\u73A9\uFF0C\u7136\u540E\u624D\u78B0\u4E0A\u4E86\u6211\u3002"
