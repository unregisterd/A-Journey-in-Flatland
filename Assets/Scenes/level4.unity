    - target: {fileID: -921310685237939977, guid: 73eb88c24457c0a41839a4bab89dc9df, type: 3}
      propertyPath: dialogLines.Array.data[2].text
      value: "\u5F53\u521D\u6211\u5728\u76D1\u72F1\u4E86\u89E3\u7684\u5E73\u9762\u56FD\u793E\u4F1A\u5236\u5EA6\u5E76\u4E0D\u5168\u9762\uFF0C\u751A\u81F3\u8FC7\u4E8E\u7247\u9762\u4E86\u3002"
