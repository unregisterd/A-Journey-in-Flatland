--- !u!1001 &9168038171237633853
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 781040313}
    m_Modifications:
    - target: {fileID: -921310685237939977, guid: 73eb88c24457c0a41839a4bab89dc9df, type: 3}
      propertyPath: dialogPanel
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: -921310685237939977, guid: 73eb88c24457c0a41839a4bab89dc9df, type: 3}
      propertyPath: dialogManager
      value: 
      objectReference: {fileID: 560256395}
    - target: {fileID: -921310685237939977, guid: 73eb88c24457c0a41839a4bab89dc9df, type: 3}
      propertyPath: memoryMessage
      value: "\u4E00\u4E2A\u597D\u5FC3\u7684\u6B63\u65B9\u5F62\u544A\u8BC9\u6211\u76D1\u72F1\u7684\u4E0B\u5C42\u66FE\u7ECF\u4F4F\u7740\u4E00\u4F4D\u4F20\u5947\u4EBA\u7269\uFF0C\u4ED6\u6210\u529F\u9A97\u8FC7\u72F1\u8B66\u5B8C\u6210\u4E86\u8D8A\u72F1\u3002\r\n\u201C\u4ED6\u662F\u600E\u4E48\u505A\u5230\u7684\uFF1F\u201D\r\n\u6B63\u65B9\u5F62\uFF1A\u201C\u4ED6\u7528\u5C0F\u52FA\u5B50\u6316\u4E86\u4E00\u6761\u901A\u9053\uFF0C\u7136\u540E\u987A\u7740\u8FD9\u6761\u901A\u9053\u79BB\u5F00\u4E86\u76D1\u72F1\uFF0C\u4ECE\u6B64\u518D\u4E5F\u6CA1\u6709\u56DE\u6765\uFF0C\u4E5F\u6CA1\u6709\u88AB\u6293\u4F4F\u3002\u201D\r\n\u6B63\u65B9\u5F62\uFF1A\u201C\u5509\uFF0C\u53EA\u4E0D\u8FC7\u4ED6\u9003\u8D70\u540E\u8FD9\u9B3C\u5730\u65B9\u52A0\u5F3A\u4E86\u9632\u8303\uFF0C\u76D1\u72F1\u4E0B\u5C42\u4ECE\u6B64\u88AB\u9501\u4F4F\uFF0C\u6211\u4EEC\u8FD9\u4E9B\u4EBA\u53EF\u518D\u4E5F\u9003\u4E0D\u8D70\u54AF\u3002\u201D\r\n\u771F\u662F\u8E0F\u7834\u8349\u978B\u65E0\u89C5\u5904\u5F97\u6765\u5168\u4E0D\u8D39\u5DE5\u592B\u554A\u3002\r\n\u8C22\u5929\u8C22\u5730\uFF0C\u90A3\u4E48\u63A5\u4E0B\u6765\u5C31\u53BB\u76D1\u72F1\u4E0B\u5C42\u5427\u3002\r\n\u6BD5\u7ADF\u6211\u4E0E\u8FD9\u4E9B\u4E8C\u7EF4\u751F\u7269\u4E0D\u4E00\u6837\uFF0C\u6211\u53EF\u4EE5\u4FEF\u89C6\u8FD9\u4E2A\u4E16\u754C\uFF0C\u53D1\u73B0\u4E00\u4E9B\u9690\u853D\u7684\u9053\u8DEF\uFF0C\u5E76\u4E14\u4ECE\u5E73\u9762\u4E00\u5934\u8DF3\u8DC3\u5230\u53E6\u4E00\u5934\u3002\r\n\u5FC5\u987B\u8981\u597D\u597D\u5229\u7528\u8FD9\u4E9B\u6280\u80FD\u9003\u51FA\u53BB\uFF0C\u7136\u540E\u590D\u4EC7\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: -921310685237939977, guid: 73eb88c24457c0a41839a4bab89dc9df, type: 3}
      propertyPath: dialogLines.Array.size
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: -921310685237939977, guid: 73eb88c24457c0a41839a4bab89dc9df, type: 3}
      propertyPath: dialogLines.Array.data[0].text
      value: "\u4ECE\u4E00\u4F4D\u597D\u5FC3\u7684\u6B63\u65B9\u5F62\uFF08\u53EF\u80FD\u56E0\u4E3A\u6211\u548C\u4ED6\u540C\u4E3A\u201C\u6B63\u65B9\u5F62\u201D\u7684\u7F18\u6545\uFF09\u90A3\u65C1\u6572\u4FA7\u51FB\u77E5\u6653\u4E86\u5E73\u9762\u56FD\u7684\u793E\u4F1A\u5236\u5EA6\uFF0C\u6240\u8C13\u68F1\u89D2\u8D8A\u591A\u5730\u4F4D\u8D8A\u9AD8\u3002\u56E0\u6B64\u4E09\u89D2\u5F62\u5929\u7136\u6BD4\u6240\u6709\u5176\u4ED6\u5E73\u9762\u56FD\u5C45\u6C11\u8981\u4F4E\u4EBA\u4E00\u7B49\uFF0C\u88AB\u89C6\u4F5C\u201C\u6B8B\u7F3A\u4EBA\u201D\u3002\u518D\u5F80\u4E0A\u662F\u6B63\u65B9\u5F62\u3001\u4E94\u8FB9\u5F62\uFF0C\u5360\u6BD4\u6700\u591A\u7684\u201C\u666E\u901A\u4EBA\u201D\u3002\u81F3\u4E8E\u66F4\u4E0A\u5C42\u7684\u516D\u8FB9\u5F62\u3001\u516B\u8FB9\u5F62\uFF0C\u90A3\u90FD\u662F\u8D35\u65CF\u9636\u7EA7\u4E86\u3002\u5E73\u9762\u56FD\u662F\u88AB\u5706\u5F62\u5BB6\u65CF\u7EDF\u6CBB\u7684\u56FD\u5BB6\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: -921310685237939977, guid: 73eb88c24457c0a41839a4bab89dc9df, type: 3}
      propertyPath: dialogLines.Array.data[1].text
      value: "\u4EC0\u4E48\uFF0C\u4F60\u8BF4\u5706\u5F62\u6CA1\u6709\u68F1\u89D2\uFF1F"
      objectReference: {fileID: 0}
    - target: {fileID: -921310685237939977, guid: 73eb88c24457c0a41839a4bab89dc9df, type: 3}
      propertyPath: dialogLines.Array.data[2].text
      value: "\u4E0D\uFF0C\u4E0D\uFF0C\u5706\u5F62\u5C31\u662F\u5929\u7136\u6700\u5C0A\u8D35\u7684\uFF0C\u4E0D\u9700\u8981\u9075\u5B88\u793E\u4F1A\u7684\u89C4\u5219\uFF0C\u5E73\u9762\u56FD\u6240\u6709\u5C45\u6C11\u90FD\u5929\u7136\u81E3\u670D\u4E8E\u5706\u5F62\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: -921310685237939977, guid: 73eb88c24457c0a41839a4bab89dc9df, type: 3}
      propertyPath: dialogLines.Array.data[3].text
      value: "\u6211\u8FD8\u5F97\u77E5\u76D1\u72F1\u7684\u4E0B\u5C42\u66FE\u7ECF\u4F4F\u7740\u4E00\u4F4D\u4F20\u5947\u4EBA\u7269\uFF0C\u4ED6\u6210\u529F\u6B3A\u9A97\u72F1\u8B66\u5B8C\u6210\u4E86\u8D8A\u72F1\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: -921310685237939977, guid: 73eb88c24457c0a41839a4bab89dc9df, type: 3}
      propertyPath: dialogLines.Array.data[4].text
      value: "\u4ED6\u662F\u600E\u4E48\u505A\u5230\u7684\uFF1F"
      objectReference: {fileID: 0}
    - target: {fileID: -921310685237939977, guid: 73eb88c24457c0a41839a4bab89dc9df, type: 3}
      propertyPath: dialogLines.Array.data[5].text
      value: "\u4ED6\u86F0\u4F0F18\u5E74\uFF0C\u7528\u5C0F\u52FA\u5B50\u6316\u4E86\u4E00\u6761\u901A\u9053\uFF0C\u7136\u540E\u987A\u7740\u8FD9\u6761\u901A\u9053\u79BB\u5F00\u4E86\u76D1\u72F1\uFF0C\u4ECE\u6B64\u518D\u4E5F\u6CA1\u6709\u56DE\u6765\uFF0C\u4E5F\u6CA1\u6709\u88AB\u6293\u4F4F\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: -921310685237939977, guid: 73eb88c24457c0a41839a4bab89dc9df, type: 3}
      propertyPath: dialogLines.Array.data[6].text
      value: "\u5509\uFF0C\u53EA\u4E0D\u8FC7\u4ED6\u9003\u8D70\u540E\u8FD9\u9B3C\u5730\u65B9\u52A0\u5F3A\u4E86\u9632\u8303\uFF0C\u76D1\u72F1\u4E0B\u5C42\u4ECE\u6B64\u88AB\u9501\u4F4F\uFF0C\u6211\u4EEC\u8FD9\u4E9B\u4EBA\u53EF\u518D\u4E5F\u9003\u4E0D\u8D70\u54AF\u3002"
